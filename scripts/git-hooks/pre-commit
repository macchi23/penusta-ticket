#!/usr/bin/env bash
# ステージした差分に秘密情報が無いか gitleaks で検査する。有効化: git config core.hooksPath scripts/git-hooks
# ホストの gitleaks（8.30.1 で確認）を使う。コンテナ経由だと GIT_INDEX_FILE や linked worktree の .git が見えず検査をすり抜ける
set -uo pipefail
root="$(git rev-parse --show-toplevel)" || exit 2
cd "$root" || exit 2

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks が無い。brew install gitleaks" >&2
  exit 1
fi

out="$(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=color.diff GIT_CONFIG_VALUE_0=never \
  gitleaks git --pre-commit --staged -v --redact --no-banner --no-color --exit-code 99 \
  --config "$root/.gitleaks.toml" "$root" 2>&1)"
rc=$?
[ -n "$out" ] && printf '%s\n' "$out" >&2

if [ "$rc" -eq 99 ]; then
  echo "秘密情報の疑いがあるのでコミットを止めた。値を消してから再コミットする。誤検知なら .gitleaks.toml で許可する" >&2
  exit 1
elif [ "$rc" -ne 0 ]; then
  echo "gitleaks の実行に失敗（rc=${rc}）。コミットを止める。急ぐときは git commit --no-verify" >&2
  exit 1
fi
case "$out" in
  *' ERR '*)
    echo "gitleaks がエラーを出した（検査できていない恐れ）。コミットを止める。急ぐときは git commit --no-verify" >&2
    exit 1
    ;;
esac
